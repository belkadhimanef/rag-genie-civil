# RAG Génie Civil — Environment Variables Template
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git — it is already in .gitignore.
#
# Get API keys at:
#   Groq   : https://console.groq.com
#   Gemini : https://aistudio.google.com/app/apikey
#   NVIDIA : https://build.nvidia.com

# ── Groq (primary LLM backend) ────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Google Gemini (alternative backend) ───────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── NVIDIA build.nvidia.com (alternative backend + evaluation judge) ───────
NVIDIA_API_KEY=nvapi-your_nvidia_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── OpenAI (optional — only needed for generation.py OpenAI backend) ───────
# OPENAI_API_KEY=sk-your_openai_key_here
